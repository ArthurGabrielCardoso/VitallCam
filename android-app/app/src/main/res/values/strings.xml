<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">VitallCam</string>
    <!-- Substitua pela URL real do seu Vercel antes de compilar -->
    <string name="app_url">https://vitallcam.vercel.app</string>

    <!--
      Notebook da clinica onde o DentalSlice roda, pro botao "Abrir no
      DentalSlice" espelhar a tela na cadeira. IP e nao ID do RustDesk porque a
      conexao e direta na LAN (Seguranca > "Enable direct IP access", porta
      21118 por padrao) — nada de tomografia passando por relay de terceiros.

      Depende de IP estavel: se o roteador entregar outro numero pro notebook, o
      botao para de funcionar. Reserve o IP por MAC no DHCP do roteador.
    -->
    <string name="notebook_dentalslice_host">192.168.15.127</string>

    <!--
      Box recem-formatada pode nao ter nenhum app de arquivos instalado. Sem
      isto o toque em "Anexar" nao daria nem erro, so silencio.
    -->
    <string name="sem_gerenciador_arquivos">Nenhum app de arquivos encontrado para escolher o documento.</string>
</resources>
